# Copy to .env to override any of these. .env is gitignored, never commit real secrets.

# Where the SQLite database file lives, relative to the project root. The app creates it (and its
# folder) automatically on first start.
DB_PATH=server/data/marketplace.db

# API port.
PORT=3001

# Adds a delay (ms) per API request, so loading skeletons are easy to see in demos. Optional.
SIMULATE_LATENCY_MS=0

# When set, enables DELETE /api/admin/data (wipes all business data) for callers that send a
# matching x-admin-token header. Unset by default, so the route doesn't exist unless configured.
ADMIN_TOKEN=

# When "true", wipes the database on the next boot (takes priority over AUTO_SEED that boot).
# Set it, restart the service, then set it back to false/unset so it doesn't clear on every boot.
DELETE_DB=false
