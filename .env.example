# Copy to .env to override any of these. .env is gitignored, never commit real secrets.

# Where the SQLite database file lives, relative to the project root. The app creates it (and its
# folder) automatically on first start.
DB_PATH=server/data/marketplace.db

# API port.
PORT=3001

# Adds a delay (ms) per API request, so loading skeletons are easy to see in demos. Optional.
SIMULATE_LATENCY_MS=0
